
{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Heritage Short Storyboard",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "version",
      "film",
      "visual_style",
      "characters",
      "narration",
      "music",
      "shots",
      "export"
    ],
    "properties": {
      "version": {
        "const": "1.0"
      },
      "film": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "title_local",
          "language",
          "subtitle_language",
          "audience",
          "intent"
        ],
        "properties": {
          "title": {
            "$ref": "#/$defs/nonempty_string"
          },
          "title_local": {
            "$ref": "#/$defs/nonempty_string"
          },
          "language": {
            "$ref": "#/$defs/nonempty_string"
          },
          "subtitle_language": {
            "const": "en"
          },
          "audience": {
            "$ref": "#/$defs/nonempty_string"
          },
          "intent": {
            "$ref": "#/$defs/nonempty_string"
          }
        }
      },
      "visual_style": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "composition",
          "width",
          "height"
        ],
        "properties": {
          "description": {
            "$ref": "#/$defs/nonempty_string"
          },
          "composition": {
            "$ref": "#/$defs/nonempty_string"
          },
          "width": {
            "type": "integer",
            "minimum": 256,
            "maximum": 2048,
            "multipleOf": 16
          },
          "height": {
            "type": "integer",
            "minimum": 256,
            "maximum": 2048,
            "multipleOf": 16
          }
        }
      },
      "characters": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "$ref": "#/$defs/character"
        }
      },
      "narration": {
        "type": "object",
        "additionalProperties": false,
        "required": ["voice", "style"],
        "properties": {
          "voice": {
            "$ref": "#/$defs/nonempty_string"
          },
          "style": {
            "$ref": "#/$defs/nonempty_string"
          }
        }
      },
      "music": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt",
          "instrumental",
          "bpm",
          "seed",
          "cues"
        ],
        "properties": {
          "prompt": {
            "$ref": "#/$defs/nonempty_string"
          },
          "instrumental": {
            "const": true
          },
          "bpm": {
            "type": "integer",
            "minimum": 40,
            "maximum": 200
          },
          "seed": {
            "$ref": "#/$defs/seed"
          },
          "cues": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/music_cue"
            }
          }
        }
      },
      "shots": {
        "type": "array",
        "minItems": 8,
        "maxItems": 12,
        "items": {
          "$ref": "#/$defs/shot"
        }
      },
      "export": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fps",
          "aspect_ratios",
          "resolution",
          "target_lufs",
          "true_peak_db",
          "end_card"
        ],
        "properties": {
          "fps": {
            "enum": [24, 25, 30]
          },
          "aspect_ratios": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": ["9:16", "16:9"]
            }
          },
          "resolution": {
            "enum": [720, 1080]
          },
          "target_lufs": {
            "type": "number",
            "minimum": -24,
            "maximum": -12
          },
          "true_peak_db": {
            "type": "number",
            "minimum": -6,
            "maximum": -1
          },
          "end_card": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "duration_seconds"],
            "properties": {
              "text": {
                "const": "Made with AI"
              },
              "duration_seconds": {
                "type": "number",
                "minimum": 2,
                "maximum": 5
              }
            }
          }
        }
      }
    },
    "$defs": {
      "nonempty_string": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "seed": {
        "type": ["integer", "null"],
        "minimum": 0,
        "maximum": 4294967295
      },
      "shot_id": {
        "type": "string",
        "pattern": "^shot_[0-9]{3}$"
      },
      "character_id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "character": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "reference_image",
          "seed"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/character_id"
          },
          "description": {
            "$ref": "#/$defs/nonempty_string"
          },
          "reference_image": {
            "$ref": "#/$defs/nonempty_string"
          },
          "seed": {
            "$ref": "#/$defs/seed"
          }
        }
      },
      "shot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "duration_seconds",
          "generation_duration_seconds",
          "reason",
          "character_ids",
          "image_prompt",
          "motion_prompt",
          "narration_text",
          "subtitle_en",
          "seed"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/shot_id"
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 1,
            "maximum": 20
          },
          "generation_duration_seconds": {
            "type": "number",
            "minimum": 1,
            "maximum": 10
          },
          "reason": {
            "$ref": "#/$defs/nonempty_string"
          },
          "character_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/character_id"
            }
          },
          "image_prompt": {
            "$ref": "#/$defs/nonempty_string"
          },
          "motion_prompt": {
            "$ref": "#/$defs/nonempty_string"
          },
          "narration_text": {
            "type": "string"
          },
          "subtitle_en": {
            "type": "string"
          },
          "seed": {
            "$ref": "#/$defs/seed"
          }
        }
      },
      "music_cue": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_shot",
          "end_shot",
          "mood"
        ],
        "properties": {
          "start_shot": {
            "$ref": "#/$defs/shot_id"
          },
          "end_shot": {
            "$ref": "#/$defs/shot_id"
          },
          "mood": {
            "$ref": "#/$defs/nonempty_string"
          }
        }
      }
    }
  }
  